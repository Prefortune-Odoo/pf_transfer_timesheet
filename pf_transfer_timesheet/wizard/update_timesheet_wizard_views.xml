<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="update_timesheet_wizard_view_form" model="ir.ui.view">
        <field name="name">update.timesheet.wizard.view.form</field>
        <field name="model">update.timesheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Timesheets">
                <group col="4">
                    <field name="project_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="task_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_update_timesheet" string="UPDATE TIMESHEET" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_update_timesheet_wizard" model="ir.actions.act_window">
        <field name="name">Update Timesheet</field>
        <field name="res_model">update.timesheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('pf_transfer_timesheet.group_update_timesheet_project_task'))]"/>
        <field name="icon">fa fa-edit</field>
    </record>
</odoo>
